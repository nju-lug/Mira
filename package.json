{
  "name": "mira",
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.0"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit --skipLibCheck && vite build",
    "preview": "vue-tsc --noEmit --skipLibCheck && vite build --base=/Mira/",
    "serve": "vite preview",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "vtsc": "vue-tsc --noEmit --skipLibCheck",
    "clean:cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
    "clean:dist": "rimraf dist",
    "clean:lock": "rimraf yarn.lock && rimraf pnpm-lock.yaml && rimraf package.lock.json && rimraf package-lock.json",
    "clean:lib": "rimraf node_modules",
    "clean": "npm run clean:dist && npm run clean:lock && npm run clean:lib"
  },
  "dependencies": {
    "dayjs": "^1.11.21",
    "lodash-es": "^4.18.1",
    "marked": "^18.0.6",
    "pinia": "^3.0.4",
    "tinycolor2": "^1.6.0",
    "vue": "^3.5.39",
    "vue-gtag": "^3.7.1",
    "vue-i18n": "^11.4.6",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "~9.1.0",
    "@intlify/devtools-types": "^11.4.6",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@types/lodash-es": "^4.17.12",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.1.1",
    "@types/tinycolor2": "^1.4.6",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "eslint": "^10.7.0",
    "less": "^4.6.7",
    "naive-ui": "^2.44.1",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "~6.0.3",
    "vfonts": "^0.0.3",
    "vite": "^8.1.4",
    "vue-tsc": "^3.3.7"
  }
}
